# ==========================================
# Variables de Entorno - Sistema Clinico UMG
# ==========================================
# Copie este archivo como .env y configure sus valores segun su entorno:

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/clinica
DB_USERNAME=clinica
DB_PASSWORD=change-me

# Seguridad y URLs
CORS_ALLOWED_ORIGINS=http://localhost:4200
CLINICA_FRONTEND_URL=http://localhost:4200
# Base64 de los archivos PEM completos, necesario para Docker y Render
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_EMAIL=superadmin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# Turnstile: defaults below are Cloudflare's public always-pass test keys for local development only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma-separated hostnames. Leave blank locally; configure the exact frontend hostname in production.
TURNSTILE_HOSTNAMES=

# Puertos
AUTH_SERVICE_PORT=8081
API_DEMO_PORT=8082
FRONTEND_PORT=4200
